{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "t4-lifecycle-event/v1",
  "title": "Lifecycle telemetry event",
  "description": "ai-factory/runs/lifecycle/events/<event_id>.json (gitignored). One immutable file per event, written by make/lifecycle.js, the headless runner and the plugin hooks through make/lifecycle-events.js. IDs, timings, outcomes and usage counts only: never prompts, document contents, secrets or command output. Readers report other versions as unsupported.",
  "type": "object",
  "required": ["schema", "version", "event_id", "type", "at", "clock", "host"],
  "properties": {
    "schema": { "const": "t4-lifecycle-event" },
    "version": { "const": 1 },
    "event_id": { "type": "string", "pattern": "^e-[0-9a-f]{32}$", "description": "The file name. Deterministic for replayable events (usage links, session bindings), so a replay is a no-op." },
    "type": { "enum": ["run_started", "phase_started", "wait_started", "wait_ended", "phase_ended", "run_ended", "usage_linked", "session_bound"] },
    "at": { "type": "string", "description": "Wall-clock ISO timestamp." },
    "clock": { "type": ["object", "null"], "properties": { "process": { "type": "string", "pattern": "^p-[0-9a-f]{16}$" }, "mono_ms": { "type": "number" } }, "description": "Monotonic reading; durations use it only between two events of the same process." },
    "host": { "enum": ["claude", "codex", "headless", "cli"] },
    "delivery_id": { "type": ["string", "null"], "pattern": "^d-[0-9]{8}-[0-9a-f]{6}$" },
    "run_id": { "type": ["string", "null"], "pattern": "^r-[0-9a-f]{16}$" },
    "parent_run_id": { "type": ["string", "null"], "pattern": "^r-[0-9a-f]{16}$" },
    "attempt_id": { "type": ["string", "null"], "pattern": "^a-[0-9a-f]{16}$" },
    "wait_id": { "type": ["string", "null"], "pattern": "^w-[0-9a-f]{16}$" },
    "phase": { "type": ["string", "null"] },
    "step": { "type": ["string", "null"], "pattern": "^S[0-9]{1,4}$" },
    "task": { "type": ["string", "null"] },
    "session_id": { "type": ["string", "null"] },
    "outcome": { "enum": ["succeeded", "failed", "interrupted", null] },
    "reason": { "type": ["string", "null"], "maxLength": 200 },
    "usage": {
      "type": ["object", "null"],
      "required": ["source", "turns", "input_tokens", "output_tokens", "cache_read_tokens", "cache_write_tokens", "cost_usd", "record_key"],
      "properties": {
        "source": { "enum": ["session", "agent", "headless"] },
        "cost_usd": { "type": ["number", "null"], "description": "null is unknown, never zero." },
        "cost_provenance": { "type": ["string", "null"], "description": "host-reported, estimated:models.yaml or estimated:built-in-rates." },
        "record_key": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 of the unique source records counted (message uuids, agent ids, response ids)." },
        "child_session": { "type": "string", "description": "Headless only: the child CLI session, so hook links for it supersede this envelope." }
      }
    }
  }
}
