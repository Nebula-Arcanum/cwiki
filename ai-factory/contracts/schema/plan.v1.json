{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "t4-contract/plan/v1",
  "title": "Plan sidecar",
  "description": "ai-factory/plans/[done/]<name>.contract.json beside <name>.md. Written by `contracts.js init plan`.",
  "type": "object",
  "required": ["schema", "version", "delivery_id", "sha256", "spec_sha256", "steps"],
  "properties": {
    "schema": { "const": "t4-contract/plan" },
    "version": { "const": 1 },
    "delivery_id": { "type": "string", "pattern": "^d-[0-9]{8}-[0-9a-f]{6}$" },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256 of the plan Markdown with checkbox marks normalized to [ ]." },
    "spec_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "The spec content this plan was written against." },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "criteria", "verify"],
        "properties": {
          "id": { "type": "string", "pattern": "^S[0-9]+$" },
          "criteria": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^AC[0-9]+$" } },
          "verify": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/verify" } },
          "withdrawn": { "type": "boolean" }
        }
      }
    },
    "migrated": { "type": "boolean" },
    "review_required": { "type": "boolean" }
  },
  "$defs": {
    "verify": {
      "type": "object",
      "required": ["argv", "phase"],
      "properties": {
        "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "description": "Executed without a shell." },
        "phase": { "enum": ["red", "step", "final"] }
      }
    }
  }
}
